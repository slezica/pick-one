<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"><!-- canvas background is the window background (Theme.PickOne) -->

    <io.slezica.pickone.component.PickerIndicatorLayout
        android:id="@+id/indicator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <TextView
        android:id="@+id/explanation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_gravity="bottom|center_horizontal"
        android:text="@string/explanation"
        android:textSize="16sp" />

    <io.slezica.pickone.component.PickerTouchOverlay
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:translationZ="1000dp" />

</FrameLayout>
