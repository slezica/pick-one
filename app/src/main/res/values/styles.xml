<resources>

    <!-- Fullscreen, edge-to-edge canvas. Transparent system bars over the dark
         hex background; light (white) bar icons are set from MainActivity. -->
    <style name="Theme.PickOne" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
